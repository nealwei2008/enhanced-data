<?xml version="1.0"?>
<project
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yoloho.enhanced.data</groupId>
        <artifactId>enhanced-data-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>enhanced-data-dao-sharding</artifactId>
    <name>enhanced-data-dao-sharding</name>
    <properties>
        <sharding.integration.excludedTags>external-integration,container-integration</sharding.integration.excludedTags>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.yoloho.enhanced.data</groupId>
            <artifactId>enhanced-data-dao</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.yoloho.enhanced.data</groupId>
            <artifactId>enhanced-data-dao-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- unit test -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${sharding.integration.excludedTags}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>sharding-integration-tests</id>
            <properties>
                <sharding.integration.excludedTags>container-integration</sharding.integration.excludedTags>
            </properties>
        </profile>
        <profile>
            <id>sharding-external-integration-tests</id>
            <properties>
                <sharding.integration.excludedTags>container-integration</sharding.integration.excludedTags>
            </properties>
        </profile>
        <profile>
            <id>sharding-container-integration-tests</id>
            <properties>
                <sharding.integration.excludedTags>external-integration</sharding.integration.excludedTags>
            </properties>
        </profile>
    </profiles>
</project>
